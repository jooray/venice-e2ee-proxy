# Required: Your Venice AI API key
VENICE_API_KEY=your-venice-api-key-here

# Optional overrides (these override config.yaml values)
# PORT=3000
# HOST=127.0.0.1
# VENICE_BASE_URL=https://api.venice.ai
# VERIFY_ATTESTATION=true
# ENABLE_DCAP=true
# Where DCAP collateral (PCK certs, CRLs, TCB info) is fetched from.
# Unset uses Phala's public PCCS, which also means they see what you verify.
# DCAP_PCCS_URL=https://pccs.phala.network
# Check GPU evidence against NVIDIA instead of Venice's own verdict.
# Fails closed when enabled. Requires VERIFY_ATTESTATION.
# VERIFY_GPU_ATTESTATION=false
# NRAS_URL=https://nras.attestation.nvidia.com/v3/attest/gpu
# SESSION_TTL=1800000
# LOG_LEVEL=info
